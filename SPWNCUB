local ItensDaBomba = { ["Bomb"] = true, ["NukeBomb1"] = true, ["NukeBomb2"] = true, ["sire1"] = true, ["Fire"] = true }
local ClassesDoLag = { ["Sound"] = true, ["ParticleEmitter"] = true, ["Explosion"] = true }

local function neutralizarBomba(objeto)
    if not CoreGui:GetAttribute("GlobalAntiLagActive") or not objeto or not objeto.Parent then return end
    if LocalPlayer.Character and objeto:IsDescendantOf(LocalPlayer.Character) then return end

    local nome, classe = objeto.Name, objeto.ClassName

    if ItensDaBomba[nome] or ClassesDoLag[classe] then
        local touchInterest = objeto:FindFirstChildOfClass("TouchInterest")
        if touchInterest then touchInterest:Destroy() end

        if objeto:IsA("BasePart") and nome ~= "Fire" then
            objeto.Transparency, objeto.CanCollide, objeto.Size = 1, false, Vector3.zero
        elseif ClassesDoLag[classe] or nome == "Fire" or nome == "sire1" then
            if objeto:IsA("Sound") then objeto.Volume = 0 objeto:Stop() end
            pcall(function() objeto:Destroy() end)
        end
    end
end

workspace.DescendantAdded:Connect(neutralizarBomba)

local function aplicarAntiLagInicial()
    if CoreGui:GetAttribute("GlobalAntiLagActive") then
        local descendants = workspace:GetDescendants()
        for i = 1, #descendants do neutralizarBomba(descendants[i]) end
    end
end

CoreGui:GetAttributeChangedSignal("GlobalAntiLagActive"):Connect(aplicarAntiLagInicial)
