local function gerenciarEstadoESP()
    local ativo = CoreGui:GetAttribute("GlobalESPActive")
    if ativo then
        criarESPHUD()
        for _, p in ipairs(Players:GetPlayers()) do
            criarESPParaJogador(p)
        end
        playerAddedConn = Players.PlayerAdded:Connect(criarESPParaJogador)
        playerRemovingConn = Players.PlayerRemoving:Connect(removerESP)
    else
        if playerAddedConn then playerAddedConn:Disconnect() playerAddedConn = nil end
        if playerRemovingConn then playerRemovingConn:Disconnect() playerRemovingConn = nil end
        removerESPHUD()
        for p, _ in pairs(espCache) do
            removerESP(p)
        end
        espCache = {}
    end
end

