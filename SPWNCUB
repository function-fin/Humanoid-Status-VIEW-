local shiftLockDeathConn = nil

local function restaurarEstadoShiftLockNormal()
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.AutoRotate = true
        hum.CameraOffset = Vector3.new(0, 0, 0)
    end
end

local function desligarShiftLockAoMorrer()
    if CoreGui:GetAttribute("GlobalShiftLockActive") then
        CoreGui:SetAttribute("GlobalShiftLockActive", false)
    else
        restaurarEstadoShiftLockNormal()
    end
end

local function conectarMorteShiftLock(char)
    if shiftLockDeathConn then
        shiftLockDeathConn:Disconnect()
        shiftLockDeathConn = nil
    end
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
    if hum then
        shiftLockDeathConn = hum.Died:Connect(desligarShiftLockAoMorrer)
    end
end

if LocalPlayer.Character then
    conectarMorteShiftLock(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    conectarMorteShiftLock(char)
end)

CoreGui:GetAttributeChangedSignal("GlobalShiftLockActive"):Connect(function()
    if not CoreGui:GetAttribute("GlobalShiftLockActive") then
