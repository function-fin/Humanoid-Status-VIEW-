local DISTANCIA_DESPERTADA = math.huge
local clickConnection = nil

local function expandirBotoesExistentes(estado)
    local distancia = estado and DISTANCIA_DESPERTADA or 32
    for _, objeto in pairs(workspace:GetDescendants()) do
        if objeto:IsA("ClickDetector") or objeto:IsA("ProximityPrompt") then
            objeto.MaxActivationDistance = distancia
        end
    end
end

local function gerenciarClick1e30()
    local ativo = CoreGui:GetAttribute("GlobalClickActive")
    if clickConnection then clickConnection:Disconnect() clickConnection = nil end

    if ativo then
        expandirBotoesExistentes(true)
        clickConnection = workspace.DescendantAdded:Connect(function(objeto)
            if objeto:IsA("ClickDetector") or objeto:IsA("ProximityPrompt") then
                objeto.MaxActivationDistance = DISTANCIA_DESPERTADA
            end
        end)

        task.spawn(function()
            while CoreGui:GetAttribute("GlobalClickActive") do
                pcall(function()
                    local setProp = sethiddenproperty or set_hidden_property or sethp
                    if setProp then
                        setProp(LocalPlayer, "SimulationRadius", 1e30)
                        setProp(LocalPlayer, "MaxSimulationRadius", 1e30)
                    elseif setsimulationradius then
                        setsimulationradius(1e30)
                    end
                end)
                RunService.RenderStepped:Wait()
            end
        end)
    else
        expandirBotoesExistentes(false)
    end
end

