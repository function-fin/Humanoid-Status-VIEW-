local antiCollisionData = {} 
local antiCollisionConnection = nil

local function processarPartAntiColisao(part)
    if not CoreGui:GetAttribute("GlobalAntiCollisionActive") then return end
    if part:IsA("BasePart") and not part.Anchored and antiCollisionData[part] == nil then
        antiCollisionData[part] = part.CanCollide 
        part.CanCollide = false
    end
end

local function desativarAntiColisao()
    if antiCollisionConnection then
        antiCollisionConnection:Disconnect()
        antiCollisionConnection = nil
    end
    for part, originalCanCollide in pairs(antiCollisionData) do
        if part and part.Parent then
            pcall(function() part.CanCollide = originalCanCollide end)
        end
    end
    antiCollisionData = {}
end

local function ativarAntiColisao()
    desativarAntiColisao()
    for _, objeto in ipairs(workspace:GetDescendants()) do processarPartAntiColisao(objeto) end
    antiCollisionConnection = workspace.DescendantAdded:Connect(function(objeto) processarPartAntiColisao(objeto) end)
end

local function sincronizarAntiColisao()
    if CoreGui:GetAttribute("GlobalAntiCollisionActive") then ativarAntiColisao() else desativarAntiColisao() end
end

